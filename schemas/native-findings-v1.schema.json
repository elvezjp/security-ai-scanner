{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/elvezjp/quality-keeper/schemas/native-findings-v1.schema.json",
  "title": "Native findings, schema version 1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "tool",
    "version",
    "generated_at",
    "subject",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "tool": {"enum": ["security-ai-scanner", "code-ai-reviewer"]},
    "version": {"type": "string", "minLength": 1},
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$"
    },
    "subject": {"$ref": "#/$defs/subject"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"tool": {"const": "security-ai-scanner"}}},
      "then": {"properties": {"findings": {"items": {"allOf": [
        {"properties": {"id": {"pattern": "^SAIS-[0-9]{4,}$"}}},
        {"not": {"required": ["category"]}}
      ]}}}}
    },
    {
      "if": {"properties": {"tool": {"const": "code-ai-reviewer"}}},
      "then": {"properties": {"findings": {"items": {"allOf": [
        {
          "required": ["category"],
          "properties": {
            "id": {"pattern": "^CAIR-[0-9]{4,}$"},
            "category": {"enum": ["bug", "regression", "test", "maintainability", "design"]}
          }
        },
        {"not": {"required": ["cwe"]}}
      ]}}}}
    }
  ],
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["kind", "root", "head_sha", "base_sha", "dirty", "content_digest"],
      "properties": {
        "kind": {"enum": ["git", "filesystem", "diff"]},
        "root": {"type": "string", "minLength": 1},
        "head_sha": {"anyOf": [
          {"type": "null"},
          {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
        ]},
        "base_sha": {"anyOf": [
          {"type": "null"},
          {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
        ]},
        "dirty": {"type": ["boolean", "null"]},
        "content_digest": {"anyOf": [
          {"type": "null"},
          {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        ]}
      },
      "allOf": [{
        "if": {"properties": {"kind": {"const": "git"}}},
        "then": {"properties": {
          "head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
          "dirty": {"type": "boolean"}
        }}
      }],
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "id", "title", "severity", "confidence", "file", "start_line",
        "description", "recommendation"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "description": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "evidence": {"type": "string"},
        "category": {"enum": ["bug", "regression", "test", "maintainability", "design"]},
        "cwe": {"type": "string", "pattern": "^CWE-[1-9][0-9]*$"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
